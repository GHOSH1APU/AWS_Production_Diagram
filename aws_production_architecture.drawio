        <!-- EC2 Instance Node AZ-A -->
        <mxCell id="ec2_a1" value="&lt;b&gt;EC2 Instance 1 (Primary ASG Member)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;Instance Type: &lt;b&gt;c7g.large&lt;/b&gt; (Graviton3, 2 vCPU, 4GB)&lt;br&gt;OS: Amazon Linux 2023 (AMI hardened)&lt;br&gt;SG: &lt;b&gt;sg-app&lt;/b&gt; (Inbound 8080 from sg-alb ONLY)&lt;br&gt;Storage: 30GB gp3 (Encrypted via KMS)&lt;br&gt;Metadata: &lt;b&gt;IMDSv2 Required&lt;/b&gt; (Hop Limit 1)&lt;br&gt;SSM Agent Active (No Port 22 / No Bastion)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="priv_sub_a">
          <mxGeometry x="15" y="35" width="430" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ec2_a2" value="&lt;b&gt;EC2 Instance (Scale-Out Replica)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#64748B;&quot;&gt;Dynamically provisioned by ASG on CPU &gt; 65%&lt;br&gt;Stateless application worker with KMS EBS root&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeDasharray=3 3;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="priv_sub_a">
          <mxGeometry x="15" y="165" width="430" height="55" as="geometry" />
        </mxCell>

        <!-- AVAILABILITY ZONE B -->
        <mxCell id="az_b" value="&lt;b&gt;Availability Zone: us-east-1b&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;dashed=1;rounded=1;startSize=25;fontSize=12;fontColor=#334155;" vertex="1" parent="vpc_group">
          <mxGeometry x="550" y="105" width="500" height="725" as="geometry" />
        </mxCell>

        <!-- Public Subnet B -->
        <mxCell id="pub_sub_b" value="&lt;b&gt;Public Subnet B — 10.0.2.0/24&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;rounded=1;startSize=25;fontSize=11;fontColor=#15803D;" vertex="1" parent="az_b">
          <mxGeometry x="20" y="35" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="alb_node_b" value="&lt;b&gt;Application Load Balancer (ALB Node)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#334155;&quot;&gt;Cross-Zone Load Balancing Active&lt;br&gt;Target Group: tg-app-production (HTTP :8080)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="pub_sub_b">
          <mxGeometry x="15" y="35" width="430" height="50" as="geometry" />
        </mxCell>
