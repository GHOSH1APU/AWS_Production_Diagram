        <!-- Title Block -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;AWS Production Architecture: EC2 Auto-Scaling, S3 Tiers &amp; Lambda Event Pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Multi-AZ Resilient Topology | Zero-Trust Private Subnets | Automated Backup &amp; DR Replication | Least Privilege IAM&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1050" height="50" as="geometry" />
