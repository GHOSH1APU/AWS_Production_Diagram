        <mxCell id="alb_a_node" value="&lt;b style=&quot;font-size:12px; color:#065F46;&quot;&gt;Application Load Balancer (ALB Node A)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;&lt;b&gt;Security Group: sg-alb&lt;/b&gt; (Inbound :80/:443 from 0.0.0.0/0)&lt;br&gt;ACM SSL/TLS 1.3 Termination | Health Probe: /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="pub_sub_a">
          <mxGeometry x="15" y="35" width="450" height="50" as="geometry" />
        </mxCell>

        <mxCell id="nat_a_node" value="&lt;b style=&quot;color:#1E40AF;&quot;&gt;NAT Gateway A&lt;/b&gt; &lt;font color=&quot;#3B82F6&quot;&gt;(Elastic IP: eip-nat-a)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Outbound Internet Egress for Private Subnet A (Yum, OS patches, external APIs)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="pub_sub_a">
